<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-neutral-border">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="text-xl font-bold text-brand-600">
        CMS Web
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <a href="/" class="text-neutral-600 hover:text-brand-600 transition-colors">Home</a>
        <a href="/about" class="text-neutral-600 hover:text-brand-600 transition-colors">About</a>
        <a href="/contact" class="text-neutral-600 hover:text-brand-600 transition-colors">Contact</a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        x-data="{ open: false }"
        @click="open = !open"
        class="md:hidden p-2 text-neutral-600 hover:text-brand-600"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>
</header>
